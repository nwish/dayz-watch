services:
  dayz-watcher:
    build: .
    # To run the published image instead of building it, delete the line above and use:
    # image: ghcr.io/nwish/dayz-watcher:latest
    restart: unless-stopped
    ports:
      - "${HOST_PORT:-8080}:8080"
    env_file:
      - path: .env
        required: false
    environment:
      PORT: "8080"
    volumes:
      - dayz-watch-data:/data

volumes:
  dayz-watch-data:
