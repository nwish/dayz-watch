services:
  dayz-watch:
    build: .
    # To run the published image instead of building it, delete the line above and use:
    # image: ghcr.io/nwish/dayz-watch:latest
    restart: unless-stopped
    ports:
      - 8080:8080 # the container always listens on 8080; change the left side for another host port
    environment:
      # true bypasses login on a trusted LAN or behind separate access control: every visitor is the local admin.
      AUTH_DISABLED: "false"
      # true allows monitoring servers on loopback/LAN addresses; they are refused otherwise.
      ALLOW_PRIVATE_ADDRESSES: "false"
      # Behind an HTTPS reverse proxy: trust X-Forwarded-* headers, and mark the session cookie Secure.
      TRUST_PROXY: "false"
      COOKIE_SECURE: "false"
      # Server list behind the add-server search box (defaults to the DZSA Launcher public list).
      # DIRECTORY_URL:
      # Polling/offline/parking settings are NOT env vars: they live in settings.json in the data volume,
      # created with defaults on first start and editable on the Admin page.
    volumes:
      - dayz-watch-data:/data

volumes:
  dayz-watch-data:
