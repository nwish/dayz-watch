# Copy to .env (git ignores it). Everything is optional.

# First-run admin (only used while no users exist; manage users in the web UI afterwards).
# Leave ADMIN_PASSWORD empty to have a random one printed in the container log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Only for a trusted LAN or behind separate access control. Every visitor becomes the local admin.
AUTH_DISABLED=false
DISCORD_WEBHOOK_URL=
POLL_SECONDS=30
# Failed polls in a row before a server counts as offline (and Discord is told).
OFFLINE_AFTER=3
# While a server isn't answering, poll it this often (seconds) instead of every POLL_SECONDS, so short restarts are caught.
RECHECK_SECONDS=5
# A downtime shorter than this many minutes is a normal restart: no Discord message. 0 = every offline server is an outage.
REBOOT_WINDOW_MINUTES=10

# Server list behind the add-server search box (defaults to the DZSA Launcher public list).
# DIRECTORY_URL=

# Host port published by compose (the container itself always listens on 8080).
HOST_PORT=8080

# Behind an HTTPS reverse proxy.
TRUST_PROXY=false
COOKIE_SECURE=false

# Only for compose.traefik.yaml:
# DOMAIN=dayzwatch.example.com
# TRAEFIK_MIDDLEWARES=
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
