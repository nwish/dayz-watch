# First-run admin (only used while no users exist; manage users in the web UI afterwards).
# Leave ADMIN_PASSWORD empty to have a random one printed in the container log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DISCORD_WEBHOOK_URL=
# Behind an HTTPS reverse proxy: true / true. Direct plain-HTTP access: leave false.
TRUST_PROXY=false
COOKIE_SECURE=false
POLL_SECONDS=30
PORT=8080
